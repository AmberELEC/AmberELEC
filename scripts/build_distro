###
### Simple script to build AmberELEC
###

if [ !"${ARCH}" == true ]
then
  echo "export ARCH before building."
  exit 1
fi

export DISTRO=AmberELEC
export PROJECT=Rockchip

# Early validation: Verify base toolchain template exists before starting the build
BASE_TEMPLATE_DEVICE=""
if [[ "${DEVICE}" =~ ^(RG351P|RG351V|RG351MP)$ ]]; then
  BASE_TEMPLATE_DEVICE="RK3326"
elif [[ "${DEVICE}" =~ ^(RG552)$ ]]; then
  BASE_TEMPLATE_DEVICE="RK3399"
elif [[ "${DEVICE}" =~ ^(RG353)$ ]]; then
  BASE_TEMPLATE_DEVICE="RK3566"
fi

if [ -n "${BASE_TEMPLATE_DEVICE}" ]; then
  BASE_TEMPLATE_DIR="build.${DISTRO}-${BASE_TEMPLATE_DEVICE}.${ARCH}"
  if [ ! -d "${BASE_TEMPLATE_DIR}/toolchain" ] || [ ! -d "${BASE_TEMPLATE_DIR}/.stamps/toolchain" ]; then
    echo "==========================================================================" >&2
    echo "==> ERROR: Required base toolchain template for '${DEVICE}' (${ARCH}) is missing!" >&2
    echo "==> Expected path: ${BASE_TEMPLATE_DIR}" >&2
    echo "==> Please build the base toolchain first via:" >&2
    echo "==>   make toolchain-${BASE_TEMPLATE_DEVICE}  (or make docker-toolchain-${BASE_TEMPLATE_DEVICE})" >&2
    echo "==========================================================================" >&2
    exit 1
  fi
fi

echo "Building ${DISTRO} for ${DEVICE}"
if [ ! -d "target" ]
then
  mkdir target
fi

# Ensure any inherited/stale cmake toolchain files are removed before starting package builds
CURRENT_BUILD_DIR="build.${DISTRO}-${DEVICE}.${ARCH}"
if [ -d "${CURRENT_BUILD_DIR}/toolchain/etc" ]; then
  rm -f "${CURRENT_BUILD_DIR}/toolchain/etc"/cmake-*.conf
fi

# Clean a few packages to ensure the build date and version are updated
for package in amberelec emulationstation retroarch retrorun lib32
do
  ./scripts/clean ${package}
done

if [ "${ARCH}" == "aarch64" ]
then
  make image
elif [ "${ARCH}" == "arm" ]
then
  # Only build the 32bit packages that we need rather than the whole image
  # to speed up the build process and save disk space.
  for package in build-lib32
  do
    scripts/build ${package}
    if [ ! $? == 0 ]
    then
      echo "Build failed..exiting."
      exit 1
    fi

    scripts/install ${package}
    if [ ! $? == 0 ]
    then
      echo "Build failed..exiting."
      exit 1
    fi
  done
fi

if [ ! $? == 0 ]
then
  echo "Build failed..exiting."
  exit 1
fi

if [ "${ARCH}" == "aarch64" ]
then
  if [ -d "release/${ARCH}/${DEVICE}" ]
  then
    rm -rf "release/${ARCH}/${DEVICE}"
  fi
mkdir -p release/${ARCH}/${DEVICE}
mv target/* "release/${ARCH}/${DEVICE}/"
fi
