From 6c8d44b8f439322a06598b2945c317f93af78751 Mon Sep 17 00:00:00 2001
From: JanTrueno <159560609+JanTrueno@users.noreply.github.com>
Date: Wed, 14 Oct 2026 18:38:10 +0200
Subject: [PATCH 7/7] arm64: dts: rockchip: miniloong: mute the speaker while
 headphones are in

Let the headset driver report jack changes to the rk817 codec, which keeps
the speaker amp off while headphones are in.

AI assistance was used in preparing this patch.
---
 arch/arm64/boot/dts/rockchip/rk3566-miniloong.dts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-miniloong.dts b/arch/arm64/boot/dts/rockchip/rk3566-miniloong.dts
index 01e209b93..a4fa5589a 100644
--- a/arch/arm64/boot/dts/rockchip/rk3566-miniloong.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3566-miniloong.dts
@@ -51,6 +51,7 @@ rk_headset: rk-headset {
 		pinctrl-names = "default";
 		pinctrl-0 = <&hp_det>;
 		io-channels = <&saradc 2>;
+		rockchip,rk817-headset-detect;
 	};
 
 	backlight: backlight {
-- 
