From caab1516fc48079bf88d20cf2bf4c59f420fa255 Mon Sep 17 00:00:00 2001
From: JanTrueno <159560609+JanTrueno@users.noreply.github.com>
Date: Wed, 14 Oct 2026 18:38:07 +0200
Subject: [PATCH 1/7] arm64: dts: rockchip: miniloong: enable the UART2 console

Enable UART2, the serial console (console=ttyS2). rk3566.dtsi leaves it
disabled.

AI assistance was used in preparing this patch.
---
 arch/arm64/boot/dts/rockchip/rk3566-miniloong.dts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-miniloong.dts b/arch/arm64/boot/dts/rockchip/rk3566-miniloong.dts
index 6ee44eb07..42d9a9ed7 100644
--- a/arch/arm64/boot/dts/rockchip/rk3566-miniloong.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3566-miniloong.dts
@@ -1525,6 +1525,10 @@ &tsadc {
 	status = "okay";
 };
 
+&uart2 {
+	status = "okay";
+};
+
 &uart1 {
 	status = "okay";
 	pinctrl-names = "default";
-- 
2.43.0

