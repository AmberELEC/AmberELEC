From a8195f95be21d8553620a28d00c974d997d53ce9 Mon Sep 17 00:00:00 2001
From: JanTrueno <159560609+JanTrueno@users.noreply.github.com>
Date: Wed, 14 Oct 2026 18:38:09 +0200
Subject: [PATCH 6/7] arm64: dts: rockchip: miniloong: present the pad as a
 GO-Super Gamepad

Present the pad as a GO-Super Gamepad, the layout AmberELEC's controller
configs expect.

AI assistance was used in preparing this patch.
---
 .../arm64/boot/dts/rockchip/rk3566-miniloong.dts | 16 +++++++++-------
 1 file changed, 9 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-miniloong.dts b/arch/arm64/boot/dts/rockchip/rk3566-miniloong.dts
index bef6972be..01e209b93 100644
--- a/arch/arm64/boot/dts/rockchip/rk3566-miniloong.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3566-miniloong.dts
@@ -243,7 +243,7 @@ button-voldown {
 		};
 	};
 	
-	joypad: singleadc-joypad {
+	joypad: odroidgo3-joypad {
 		/*
 		 * Requires patched singleadcjoy.c with Miniloong direct-adc mode.
 		 *
@@ -266,8 +266,10 @@ joypad: singleadc-joypad {
 		/* pwms = <&pwm5 0 10000 0>; */
 		pwms = <&pwm2 0 10000 0>;
 
-		joypad-name = "retrogame_joypad";
-		joypad-product = <0x1101>;
+		joypad-name = "GO-Super Gamepad";
+		joypad-product = <0x1100>;
+		/* no right-stick click; keep MODE on the GO-Super F5 index */
+		linux,placeholder-codes = <BTN_TRIGGER_HAPPY4>;
 		joypad-revision = <0x0100>;
 
 		/*
@@ -355,19 +357,19 @@ sw8 {
 		sw9 {
 			gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_LOW>;
 			label = "SELECT";
-			linux,code = <BTN_SELECT>;
+			linux,code = <BTN_TRIGGER_HAPPY1>;
 		};
 
 		sw10 {
 			gpios = <&gpio4 RK_PA3 GPIO_ACTIVE_LOW>;
 			label = "START";
-			linux,code = <BTN_START>;
+			linux,code = <BTN_TRIGGER_HAPPY2>;
 		};
 
 		sw11 {
 			gpios = <&gpio4 RK_PA6 GPIO_ACTIVE_LOW>;
 			label = "MODE";
-			linux,code = <BTN_MODE>;
+			linux,code = <BTN_TRIGGER_HAPPY5>;
 		};
 
 		sw12 {
@@ -397,7 +399,7 @@ sw15 {
 		sw16 {
 			gpios = <&gpio2 RK_PC5 GPIO_ACTIVE_LOW>;
 			label = "LEFT JOYSTICK MIDDLE";
-			linux,code = <BTN_THUMBL>;
+			linux,code = <BTN_TRIGGER_HAPPY3>;
 		};
 	};
 
-- 
