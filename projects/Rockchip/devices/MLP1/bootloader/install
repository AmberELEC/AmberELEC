PKG_RKBIN="$(get_build_dir rkbin)"
LINUX_DTS_DIR="$(get_build_dir linux)/.install_pkg/usr/share/bootloader"

tools/mkimage -n rk356x -T rksd \
  -d "${PKG_RKBIN}/bin/rk35/rk3566_ddr_1056MHz_v1.21.bin:spl/u-boot-spl.bin" \
  -C bzip2 idbloader.img

# The BSP U-Boot takes its own hardware description from rk-kernel.dtb in
# resource.img. It needs the -uboot variant (simple-panel-dsi panel, plain
# retrogame_joypad), not the kernel DTB the OS boots with.
cp "${LINUX_DTS_DIR}/rk3566-miniloong-uboot.dtb" rk-kernel.dtb
tools/resource_tool --pack --image=resource.img rk-kernel.dtb

cp idbloader.img u-boot.itb resource.img "${LINUX_DTS_DIR}/rk3566-miniloong.dtb" "${INSTALL}/usr/share/bootloader/"
mkdir -p "${INSTALL}/usr/share/bootloader/extlinux"
cat > "${INSTALL}/usr/share/bootloader/extlinux/extlinux.conf" <<EOF
LABEL ${DISTRO_BOOTLABEL}
  LINUX /${KERNEL_NAME}
  FDT /rk3566-miniloong.dtb
  APPEND boot=UUID=@BOOT_UUID@ disk=UUID=@DISK_UUID@ quiet ${EXTRA_CMDLINE}
EOF
