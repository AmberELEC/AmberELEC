--- a/arch/arm/dts/Makefile
+++ b/arch/arm/dts/Makefile
@@ -466,3 +466,5 @@
 	@:
 
 clean-files := *.dtb
+
+dtb-y += rk3566-arc-d-sd.dtb
diff --git a/arch/arm/dts/rk3566-arc-d-sd.dts b/arch/arm/dts/rk3566-arc-d-sd.dts
new file mode 100644
--- /dev/null
+++ b/arch/arm/dts/rk3566-arc-d-sd.dts
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+#include "rk3568-evb.dts"
+
+/ {
+	model = "Anbernic RG ARC-D SD boot probe";
+	compatible = "anbernic,rg-arc-d", "rockchip,rk3566";
+
+	chosen {
+		u-boot,spl-boot-order = &sdmmc0;
+	};
+};
+
+&sdhci {
+	status = "disabled";
+	/delete-property/ u-boot,dm-spl;
+};
+
+&sdmmc1 {
+	status = "disabled";
+	/delete-property/ u-boot,dm-spl;
+};
+
+&nandc0 {
+	status = "disabled";
+	/delete-property/ u-boot,dm-spl;
+};
+
+&sfc {
+	status = "disabled";
+	/delete-property/ u-boot,dm-spl;
+};
diff --git a/arch/arm/mach-rockchip/board.c b/arch/arm/mach-rockchip/board.c
--- a/arch/arm/mach-rockchip/board.c
+++ b/arch/arm/mach-rockchip/board.c
@@ -363,6 +363,14 @@
 
 int board_late_init(void)
 {
+#ifdef CONFIG_ANBERNIC_ARC_SD_ONLY
+	/* Exclude Android BCB, download, charging and recovery boot paths. */
+	if (!rockchip_get_bootdev())
+		hang();
+	env_fixup();
+	env_set("fdtfile", "rk3566-arc-d-sd-probe.dtb");
+	return rk_board_late_init();
+#endif
 	rockchip_set_ethaddr();
 	rockchip_set_serialno();
 	setup_download_mode();
diff --git a/arch/arm/mach-rockchip/boot_rkimg.c b/arch/arm/mach-rockchip/boot_rkimg.c
--- a/arch/arm/mach-rockchip/boot_rkimg.c
+++ b/arch/arm/mach-rockchip/boot_rkimg.c
@@ -46,6 +46,22 @@
 
 	if (done)
 		return;
+
+#ifdef CONFIG_ANBERNIC_ARC_SD_ONLY
+	{
+		struct mmc *sd;
+
+		mmc_initialize(gd->bd);
+		sd = find_mmc_device(1);
+		if (!sd || mmc_init(sd) || !IS_SD(sd)) {
+			puts("ARC-D: removable SD unavailable; stopping\n");
+			hang();
+		}
+		env_set("devtype", "mmc");
+		env_set("devnum", "1");
+		goto finish;
+	}
+#endif
 
 #if defined(CONFIG_SCSI) && defined(CONFIG_CMD_SCSI) && defined(CONFIG_AHCI)
 	ret = run_command("scsi scan", 0);
diff --git a/arch/arm/mach-rockchip/rk3568/Kconfig b/arch/arm/mach-rockchip/rk3568/Kconfig
--- a/arch/arm/mach-rockchip/rk3568/Kconfig
+++ b/arch/arm/mach-rockchip/rk3568/Kconfig
@@ -5,6 +5,14 @@
 	select BOARD_LATE_INIT
 	help
 	  RK3568 EVB is a evaluation board for Rockchp RK3568.
+
+config ANBERNIC_ARC_SD_ONLY
+	bool "Confine the Anbernic ARC-D boot probe to SD"
+	depends on TARGET_EVB_RK3568
+	help
+	  Restrict the ARC-D bring-up loader to the removable SD card.
+	  Do not follow Android boot modes or preloader eMMC selections.
+	  The dedicated device tree must also disable internal storage.
 
 config SYS_SOC
 	default "rockchip"
diff --git a/arch/arm/mach-rockchip/spl-boot-order.c b/arch/arm/mach-rockchip/spl-boot-order.c
--- a/arch/arm/mach-rockchip/spl-boot-order.c
+++ b/arch/arm/mach-rockchip/spl-boot-order.c
@@ -142,6 +142,19 @@
 	int node;
 	const char *conf;
 
+#ifdef CONFIG_ANBERNIC_ARC_SD_ONLY
+	/* Keep alias numbering explicit even though the eMMC node is disabled. */
+	node = fdt_path_offset(blob, "/dwmmc@fe2b0000");
+	boot_device = node < 0 ? -ENOENT : spl_node_to_boot_device(node);
+	if (boot_device < 0) {
+		puts("ARC-D SPL: SD unavailable; stopping\n");
+		hang();
+	}
+	spl_boot_list[0] = boot_device;
+	spl_boot_list[1] = BOOT_DEVICE_NONE;
+	return;
+#endif
+
 	if (chosen_node < 0) {
 		debug("%s: /chosen not found, using spl_boot_device()\n",
 		      __func__);
diff --git a/common/fdt_support.c b/common/fdt_support.c
