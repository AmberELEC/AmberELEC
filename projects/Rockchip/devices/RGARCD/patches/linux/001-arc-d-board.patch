diff --git a/arch/arm64/boot/dts/rockchip/rk3566-arc-d-sd-probe.dts b/arch/arm64/boot/dts/rockchip/rk3566-arc-d-sd-probe.dts
new file mode 100644
index 000000000..cfbf1bfd7
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3566-arc-d-sd-probe.dts
@@ -0,0 +1,8 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+#include "rk3566-arc-d.dts"
+
+/* The first boot trial must not access a card in the games slot. */
+&sdmmc1 {
+	status = "disabled";
+};
diff --git a/arch/arm64/boot/dts/rockchip/rk3566-arc-d.dts b/arch/arm64/boot/dts/rockchip/rk3566-arc-d.dts
new file mode 100644
index 000000000..48fa9a349
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3566-arc-d.dts
@@ -0,0 +1,321 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+/* Reuse the existing RK3566 BSP power, storage and peripheral definitions. */
+#include "rk3566-353m.dts"
+
+/ {
+	model = "Anbernic RG ARC-D";
+	compatible = "anbernic,rg-arc-d", "rockchip,rk3566";
+
+	arc_gamepad: arc-gamepad {
+		/* Match the native RG ARC joypad expected by the UOS mappings. */
+		compatible = "singleadc-joypad";
+		joypad-name = "rg_arc_joypad";
+		joypad-product = <0x0a2c>;
+		joypad-revision = <0x0100>;
+		hw_info = <0x05>;
+		hw_pcb_info = <0x05>;
+		status = "okay";
+		pinctrl-names = "default";
+		pinctrl-0 = <&arc_btn_pins>;
+		io-channel-names = "amux_adc";
+		io-channels = <&saradc 3>;
+		amux-count = <4>;
+		amux-a-gpios = <&gpio0 RK_PB6 GPIO_ACTIVE_LOW>;
+		amux-b-gpios = <&gpio0 RK_PB7 GPIO_ACTIVE_LOW>;
+		amux-en-gpios = <&gpio0 RK_PB5 GPIO_ACTIVE_LOW>;
+		button-adc-scale = <2>;
+		button-adc-deadzone = <255>;
+		button-adc-fuzz = <32767>;
+		button-adc-flat = <32767>;
+		abs_x-p-tuning = <0>;
+		abs_x-n-tuning = <0>;
+		abs_y-p-tuning = <0>;
+		abs_y-n-tuning = <0>;
+		abs_rx-p-tuning = <0>;
+		abs_rx-n-tuning = <0>;
+		abs_ry-p-tuning = <0>;
+		abs_ry-n-tuning = <0>;
+		poll-interval = <10>;
+
+		button-up {
+			label = "GPIO DPAD-UP";
+			gpios = <&gpio3 RK_PA3 GPIO_ACTIVE_LOW>;
+			linux,code = <0x220>;
+		};
+
+		button-down {
+			label = "GPIO DPAD-DOWN";
+			gpios = <&gpio3 RK_PA4 GPIO_ACTIVE_LOW>;
+			linux,code = <0x221>;
+		};
+
+		button-left {
+			label = "GPIO DPAD-LEFT";
+			gpios = <&gpio3 RK_PA6 GPIO_ACTIVE_LOW>;
+			linux,code = <0x222>;
+		};
+
+		button-right {
+			label = "GPIO DPAD-RIGHT";
+			gpios = <&gpio3 RK_PA5 GPIO_ACTIVE_LOW>;
+			linux,code = <0x223>;
+		};
+
+		button-a {
+			label = "GPIO BTN-A";
+			gpios = <&gpio3 RK_PC3 GPIO_ACTIVE_LOW>;
+			linux,code = <0x134>;
+		};
+
+		button-b {
+			label = "GPIO BTN-B";
+			gpios = <&gpio3 RK_PC2 GPIO_ACTIVE_LOW>;
+			linux,code = <0x131>;
+		};
+
+		button-c {
+			label = "GPIO BTN-C";
+			gpios = <&gpio3 RK_PA2 GPIO_ACTIVE_LOW>;
+			linux,code = <0x13e>;
+		};
+
+		button-x {
+			label = "GPIO BTN-X";
+			gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_LOW>;
+			linux,code = <0x133>;
+		};
+
+		button-y {
+			label = "GPIO BTN-Y";
+			gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_LOW>;
+			linux,code = <0x130>;
+		};
+
+		button-z {
+			label = "GPIO BTN-Z";
+			gpios = <&gpio3 RK_PA1 GPIO_ACTIVE_LOW>;
+			linux,code = <0x13d>;
+		};
+
+		button-select {
+			label = "GPIO BTN_SELECT";
+			gpios = <&gpio3 RK_PB6 GPIO_ACTIVE_LOW>;
+			linux,code = <0x13a>;
+		};
+
+		button-start {
+			label = "GPIO BTN_START";
+			gpios = <&gpio3 RK_PB5 GPIO_ACTIVE_LOW>;
+			linux,code = <0x13b>;
+		};
+
+		button-f {
+			label = "GPIO BTN_F";
+			gpios = <&gpio3 RK_PC4 GPIO_ACTIVE_LOW>;
+			linux,code = <0x13c>;
+		};
+
+		button-l1 {
+			label = "GPIO BTN_TL";
+			gpios = <&gpio3 RK_PB1 GPIO_ACTIVE_LOW>;
+			linux,code = <0x136>;
+		};
+
+		button-r1 {
+			label = "GPIO BTN_TR";
+			gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_LOW>;
+			linux,code = <0x137>;
+		};
+
+		button-l2 {
+			label = "GPIO BTN_TL2";
+			gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
+			linux,code = <0x138>;
+		};
+
+		button-r2 {
+			label = "GPIO BTN_TR2";
+			gpios = <&gpio3 RK_PB3 GPIO_ACTIVE_LOW>;
+			linux,code = <0x139>;
+		};
+	};
+};
+
+/* ARC has digital controls and no sticks or rumble motor. */
+	&joypad {
+	status = "disabled";
+};
+
+&pwm5 {
+	status = "disabled";
+};
+
+&backlight {
+	brightness-levels = <
+		2 5 7 10 12 15 17 20 22 25 27 30
+		32 35 37 40 42 45 48 50 53 55 58 60
+		63 65 68 70 73 75 78 80 83 85 88 91
+		93 96 98 101 103 106 108 111 113 116 118 121
+		123 126 128 131 134 136 139 141 144 146 149 151
+		154 156 159 161 164 166 169 172 174 177 179 182
+		184 187 189 192 194 197 199 202 204 207 209 212
+		215 217 220 222 225 227 230 232 235 237 240 242
+		245 247 250 252 255
+	>;
+	default-brightness-level = <50>;
+};
+
+&dsi0 {
+	/delete-node/ panel@1;
+	ports {
+		/delete-node/ port@2;
+	};
+};
+
+&dsi0_panel {
+	compatible = "aoly,sl008pa21y1285-b00", "simple-panel-dsi";
+	/delete-property/ id;
+	/delete-property/ num;
+	/delete-property/ id-reg;
+	dsi,lanes = <2>;
+	dsi,flags = <0x0a03>;
+	rotation = <90>;
+	prepare-delay-ms = <20>;
+	reset-delay-ms = <220>;
+	init-delay-ms = <120>;
+	enable-delay-ms = <50>;
+	disable-delay-ms = <50>;
+	unprepare-delay-ms = <20>;
+	/* Preserve the command bytes and delays read from the working panel. */
+	panel-init-sequence = [
+		39 00 06 ff 77 01 00 00 13
+		15 00 02 ef 08
+		39 00 06 ff 77 01 00 00 10
+		39 00 03 c0 4f 03
+		39 00 03 c1 0c 02
+		39 00 03 c2 10 06
+		15 00 02 c7 04
+		15 00 02 cc 38
+		39 00 11 b0 40 16 1d 0e 12 06 0c 0a 09 25 00 03 00 3f 3f 1c
+		39 00 11 b1 40 16 1e 0e 11 06 0c 08 09 26 00 15 00 3f 3f 1c
+		39 00 06 ff 77 01 00 00 11
+		15 00 02 b0 4d
+		15 00 02 b1 35
+		15 00 02 b2 07
+		15 00 02 b3 80
+		15 00 02 b5 47
+		15 00 02 b7 85
+		15 00 02 b8 20
+		15 00 02 b9 10
+		15 00 02 bc 03
+		15 00 02 c0 89
+		15 00 02 c1 78
+		15 00 02 c2 78
+		15 00 02 d0 88
+		39 00 04 e0 00 00 02
+		39 00 0c e1 04 00 00 00 05 00 00 00 00 20 20
+		39 00 0e e2 00 00 00 00 00 00 00 00 00 00 00 00 00
+		39 00 05 e3 00 00 33 00
+		39 00 03 e4 22 00
+		39 00 11 e5 04 5c a0 a0 06 5c a0 a0 00 00 00 00 00 00 00 00
+		39 00 05 e6 00 00 33 00
+		39 00 03 e7 22 00
+		39 00 11 e8 05 5c a0 a0 07 5c a0 a0 00 00 00 00 00 00 00 00
+		39 00 08 eb 02 00 40 40 00 00 00
+		39 00 03 ec 00 00
+		39 00 11 ed fa 45 0b ff ff ff ff ff ff ff ff ff ff b0 54 af
+		39 00 07 ef 08 08 08 45 3f 54
+		39 00 06 ff 77 01 00 00 00
+		15 00 02 36 17
+		15 00 02 3a 77
+		05 c8 01 11
+		05 c8 01 29
+	];
+	panel-exit-sequence = [
+		05 dc 01 28
+		05 78 01 10
+	];
+};
+
+&timing0 {
+	clock-frequency = <25600000>;
+	hactive = <480>;
+	vactive = <640>;
+	hfront-porch = <60>;
+	hsync-len = <42>;
+	hback-porch = <60>;
+	vfront-porch = <10>;
+	vsync-len = <4>;
+	vback-porch = <10>;
+	hsync-active = <0>;
+	vsync-active = <0>;
+	de-active = <0>;
+	pixelclk-active = <1>;
+};
+
+/* Keep Android's internal storage outside the Linux device model. */
+&sdhci {
+	status = "disabled";
+};
+
+&nandc0 {
+	status = "disabled";
+};
+
+&sfc {
+	status = "disabled";
+};
+
+&i2c2 {
+	pinctrl-names = "default";
+	/delete-node/ touch@1a;
+
+	touchscreen@14 {
+		compatible = "goodix,gt9xx";
+		reg = <0x14>;
+		interrupt-parent = <&gpio4>;
+		interrupts = <RK_PB1 IRQ_TYPE_EDGE_FALLING>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&touch_gt_gpio>;
+		goodix,rst-gpio = <&gpio4 RK_PA6 GPIO_ACTIVE_LOW>;
+		goodix,irq-gpio = <&gpio4 RK_PB1 GPIO_ACTIVE_LOW>;
+		/* Validate the BSP controller configuration before enabling touch. */
+		status = "disabled";
+	};
+};
+
+&pinctrl {
+	arc-gamepad {
+		arc_btn_pins: arc-btn-pins {
+			rockchip,pins =
+				<3 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PA4 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PC3 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PC2 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PA2 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PB1 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+};
+
+/* The first ARC validation uses the working Android clock range. */
+&cpu0_opp_table {
+	/delete-node/ opp-216000000;
+	/delete-node/ opp-1992000000;
+};
+
+&gpu_opp_table {
+	/delete-node/ opp-100000000;
+};
